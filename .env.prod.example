# Copiar a .env.prod (no se versiona) y completar. Generar secretos con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PUBLIC_URL=https://adan.example.com
POSTGRES_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=
SANDBOX_TOKEN=
METRICS_TOKEN=
# Etiqueta de las imágenes (deploy.sh la fija con el commit)
ADAN_TAG=local
HTTP_PORT=80
# Modelo local para tareas simples. En producción, uno de 7B o más (WO-099).
DEFAULT_MODEL=qwen2.5:7b
# Claude (Anthropic) para conversación, diagnóstico y Board Room. Sin clave, todo corre
# en Ollama y /api/v1/companies/<id>/llm-usage marca las llamadas como degradadas.
ANTHROPIC_API_KEY=
# LLM_MODEL_STANDARD=claude-sonnet-5
# LLM_MODEL_COMPLEX=claude-opus-5
# LLM_MODEL_FAST=claude-haiku-4-5
WEB_CONCURRENCY=2
