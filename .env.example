# ADÁN — variables de entorno. Copia este archivo a .env y ajusta los valores.
# Desarrollo: `docker compose up`  ·  Producción: `docker compose -f docker-compose.prod.yml up -d --build`

# --- Seguridad (OBLIGATORIO en producción) ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE-ME-IN-PRODUCTION
# Orígenes del frontend separados por coma (nunca '*' en producción)
CORS_ORIGINS=http://localhost:5174,http://localhost:5173
# Intentos de login/registro por IP y minuto (0 = sin límite)
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- Base de datos: PostgreSQL + pgvector (WO-091) ---
POSTGRES_USER=adan
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=adan
# Fuera de Docker: si no se define DATABASE_URL se usa SQLite en backend/data/adan.db
# DATABASE_URL=postgresql+psycopg://adan:CHANGE-ME@localhost:5433/adan

# --- IA (Ollama) ---
DEFAULT_MODEL=qwen2.5:0.5b
# Embeddings del EMS: local (sin dependencias) u ollama (semánticos reales)
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=nomic-embed-text
# En producción, descargar también el modelo de embeddings al arrancar:
# PULL_EMBEDDING_MODEL=nomic-embed-text

# --- TEF / red (WO-090) ---
# Directorio único desde el que file_reader puede leer (default: backend/data/files)
# TEF_FILES_DIR=
# Ejecuta código Python arbitrario como el proceso del backend: dejar en false salvo entorno aislado
TEF_ENABLE_PYTHON_SANDBOX=false
# Permite que TEF http_request, DKA e integraciones llamen a localhost / redes
# privadas (riesgo SSRF): dejar en false salvo integraciones de intranet
ALLOW_PRIVATE_HTTP=false

# --- Operación (WO-093) ---
# Workers de uvicorn en producción
WEB_CONCURRENCY=2
# Puerto HTTP publicado por nginx en producción
HTTP_PORT=80
LOG_LEVEL=INFO
# METRICS_ENABLED=true
# ENABLE_DOCS=false
