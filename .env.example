# Copia este archivo a .env y ajusta los valores.
JWT_SECRET=CHANGE-ME-IN-PRODUCTION
DEFAULT_MODEL=qwen2.5:0.5b

# Base de datos (WO-091). Docker Compose usa PostgreSQL + pgvector automáticamente.
POSTGRES_USER=adan
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=adan
# Fuera de Docker: si no se define, se usa SQLite en backend/data/adan.db
# DATABASE_URL=postgresql+psycopg://adan:CHANGE-ME@localhost:5433/adan

# Embeddings del EMS: local (sin dependencias) u ollama (semánticos; requiere `ollama pull nomic-embed-text`)
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=nomic-embed-text

# TEF (Tool Execution Framework) — endurecimiento de seguridad
# Directorio único desde el que file_reader puede leer (default: backend/data/files)
# TEF_FILES_DIR=
# Ejecuta código Python arbitrario como el proceso del backend: dejar en false salvo entorno aislado
TEF_ENABLE_PYTHON_SANDBOX=false
# Permite que http_request llame a localhost / redes privadas (riesgo SSRF)
TEF_ALLOW_PRIVATE_HTTP=false
