    "/kg/query": {
      "get": {
        "tags": [
          "knowledge-graph"
        ],
        "summary": "Hybrid Query",
        "description": "Combina busqueda semantica (pgvector cosine_distance) + traversal del grafo desde\nlos mejores resultados semanticos - misma logica que ai/memory/hybrid_query.py,\nreimplementada aqui sobre los modelos espejo del backend (sin import cruzado,\nPlan Maestro SS3.2). Ver docstring de ese modulo para la justificacion completa.",
        "operationId": "hybrid_query_kg_query_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Q"
            }
          },
          {
            "name": "proyecto_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Proyecto Id"
            }
          },
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5,
              "title": "Top K"
            }
          },
          {
            "name": "graph_depth",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "title": "Graph Depth"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HybridResultResponse"
                  },
                  "title": "Response Hybrid Query Kg Query Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
