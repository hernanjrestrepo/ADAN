{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "adan-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "--app-dir",
        "backend",
        "app.main:app",
        "--port",
        "8020"
      ],
      "port": 8020
    },
    {
      "name": "adan-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    }
  ]
}
